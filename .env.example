# Environment Variables - NutriBot Project
# Copy this file to .env and fill in your values
# DO NOT commit .env to git!

# Google OAuth2
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Database (optional - defaults already in application.properties)
# SPRING_DATASOURCE_URL=jdbc:sqlserver://localhost:1433;databaseName=NutriBotV2
# SPRING_DATASOURCE_USERNAME=sa
# SPRING_DATASOURCE_PASSWORD=12345

# JWT Secret (optional - default provided)
# JWT_SECRET=your_jwt_secret_here

# AI Service (optional - default: http://localhost:8000)
# AI_SERVICE_BASE_URL=http://localhost:8000

# Cloudinary (optional - for image uploads)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
